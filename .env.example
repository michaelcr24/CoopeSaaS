VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Secretos de las Edge Functions de grabacion/transcripcion de asambleas
# (NO van aqui ni en ningun archivo VITE_* — se configuran como Supabase
# Edge Function secrets: `supabase secrets set OPENAI_API_KEY=... ANTHROPIC_API_KEY=...`
# o desde el Dashboard -> Edge Functions -> Secrets)
#   OPENAI_API_KEY      -> usado por supabase/functions/asamblea-transcribir
#   ANTHROPIC_API_KEY   -> usado por supabase/functions/asamblea-generar-minuta
